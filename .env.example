# ============================================================================
# Variables de entorno — barbershop-booking-app
# ----------------------------------------------------------------------------
# Copialo a `.env.local` y completá con los valores reales.
# `.env.local` está gitignored: nunca commitees secrets.
# ============================================================================

# Supabase
# ----------------------------------------------------------------------------
# Las encontrás en: Supabase Dashboard → tu proyecto → Project Settings → API
# - URL: "Project URL"
# - PUBLISHABLE_KEY: "Project API keys" → la del formato `sb_publishable_*`
#   (es el reemplazo moderno de la legacy "anon" key con formato JWT eyJ...).
#
# La publishable key es segura para exponer al cliente (las restricciones
# reales vienen de las policies RLS definidas en supabase/migrations/0001_init.sql).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
