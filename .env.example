# ============================================================================
# Variables de entorno — barbershop-booking-app
# ----------------------------------------------------------------------------
# Copialo a `.env.local` y completá con los valores reales.
# `.env.local` está gitignored: nunca commitees secrets.
# ============================================================================

# Supabase
# ----------------------------------------------------------------------------
# Opción A — Supabase local (`pnpm db:start`): los valores salen por consola
#   - URL: "Project URL" (http://127.0.0.1:54321)
#   - PUBLISHABLE_KEY: "Publishable" (sb_publishable_...)
#
# Opción B — Supabase cloud: Dashboard → tu proyecto → Project Settings → API Keys
#   - URL: "Project URL"
#   - PUBLISHABLE_KEY: "Publishable key" (sb_publishable_...).
#     Si tu proyecto todavía usa las keys legacy, va la "anon" key acá.
#
# La publishable key es segura para exponer al cliente (las restricciones reales
# vienen de las policies RLS definidas en supabase/migrations/0001_init.sql).
# La secret / service_role key NUNCA va con prefijo NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Sitio
# ----------------------------------------------------------------------------
# URL pública (para og:image y links absolutos). Opcional: en Vercel se toma
# sola del dominio de producción; seteala si usás dominio propio.
# NEXT_PUBLIC_SITE_URL=https://tu-dominio.com
